{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // The site is served only at its custom domain, portfolio.inenico.dev, which is attached in the
  // Cloudflare dashboard (Wrangler leaves it alone, as it is not listed here). Without these, each
  // deploy would turn the <name>.<subdomain>.workers.dev address back on.
  "workers_dev": false,
  "preview_urls": false
}
